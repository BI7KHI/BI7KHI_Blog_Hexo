<% if (options.beian && (options.beian.icp || options.beian.police || options.beian.custom)) { %>
<div class="nexmoe-widget-wrap">
	<div class="nexmoe-widget nexmoe-beian">
		<div class="beian-content">
			<% if (options.beian.icp) { %>
			<div class="beian-item">
				<a href="https://beian.miit.gov.cn/" target="_blank" rel="nofollow">
					<%= options.beian.icp %>
				</a>
			</div>
			<% } %>
			
			<% if (options.beian.police) { %>
			<div class="beian-item">
				<a href="<%= options.beian.police.url || 'http://www.beian.gov.cn/portal/registerSystemInfo' %>" target="_blank" rel="nofollow">
					<% if (options.beian.police.icon !== false) { %>
					<img src="data:image/png;base64," alt="公安备案" style="display: inline-block; vertical-align: text-bottom; width: 14px; height: 14px; margin-right: 3px;">
					<% } %>
					<%= options.beian.police.number %>
				</a>
			</div>
			<% } %>
			
			<% if (options.beian.custom && options.beian.custom.length > 0) { %>
			<% options.beian.custom.forEach(function(item) { %>
			<div class="beian-item">
				<% if (item.url) { %>
				<a href="<%= item.url %>" target="_blank" rel="nofollow">
					<%= item.text %>
				</a>
				<% } else { %>
				<span><%= item.text %></span>
				<% } %>
			</div>
			<% }) %>
			<% } %>
		</div>
	</div>
</div>

<style>
.nexmoe-beian {
	padding: 15px;
	font-size: 12px;
	color: #888;
	line-height: 1.6;
	text-align: center;
}

.beian-content {
	display: flex;
	flex-direction: column;
	gap: 8px;
}

.beian-item {
	display: flex;
	align-items: center;
	justify-content: center;
}

.beian-item a {
	color: #888;
	text-decoration: none;
	transition: color 0.3s ease;
}

.beian-item a:hover {
	color: #555;
	text-decoration: underline;
}

.beian-item img {
	vertical-align: text-bottom;
	margin-right: 3px;
}

/* 响应式设计 */
@media (max-width: 768px) {
	.nexmoe-beian {
		font-size: 11px;
		padding: 12px;
	}
	
	.beian-content {
		gap: 6px;
	}
}

/* 深色主题适配 */
@media (prefers-color-scheme: dark) {
	.beian-item a {
		color: #aaa;
	}
	
	.beian-item a:hover {
		color: #ccc;
	}
}
</style>
<% } %>
